# Segreti di Softloop. Questo file resta solo sulla VM (è in .gitignore): non incollarlo mai in chat.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# 1 = carica e programma su YouTube da solo. Mettilo a 1 solo quando il test
# `python publish.py <video> --test` non risulta "Bloccato" in YouTube Studio.
YT_AUTO_PUBLISH=0
# Orario di uscita (default 13:00 a New York = 19:00 in Italia)
# YT_PUBLISH_TIME=13:00
# YT_PUBLISH_TZ=America/New_York
